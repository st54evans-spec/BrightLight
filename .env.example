# Server
PORT=3111
JWT_SECRET=change-me
# DATABASE_URL=postgres://...   (production only; dev uses ./database/auth.db3)

# The accountant (Grok bot)
XAI_API_KEY=                 # from https://console.x.ai  - required for chat
XAI_MODEL=grok-4             # any xAI chat model with tool calling
XAI_AGENT_TOOLS=on           # on|off - server-side web_search + x_search for current lender rates
# XAI_LIVE_SEARCH=on         # legacy alias of XAI_AGENT_TOOLS (search_parameters is not used)
FINANCE_BOT_NAME=Cato Ledger
FINANCE_BOT_TITLE=Virtual Accountant & CFO
FINANCE_OWNER_NAME=
FINANCE_BUSINESS_ENTITY=sole proprietorship   # or "LLC", "S-Corp", "partnership" (moves the 3/15 deadline)
FINANCE_NJ_ANNIVERSARY_MONTH=12               # month the NJ annual report is due
PRIME_RATE=0.0675

# Bank / card / investment data (optional)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox            # sandbox|development|production

# Credit report provider (optional; any JSON endpoint, see finance/integrations/credit.js)
CREDIT_API_URL=
CREDIT_API_KEY=
