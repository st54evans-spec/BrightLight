# Copy to .env and fill in. Never commit real keys.

# Your own LLM accounts — this app talks to these, NOT to Meta AI.
ANTHROPIC_API_KEY=sk-ant-...
XAI_API_KEY=xai-...

# Which assistant answers when you don't name one ("claude" or "grok").
DEFAULT_BOT=claude

# Optional model overrides.
CLAUDE_MODEL=claude-sonnet-4-5
GROK_MODEL=grok-4

# MentraOS app credentials (from console.mentra.glass). Only needed to run on glasses.
MENTRA_PACKAGE_NAME=com.yourname.glassescopilot
MENTRA_API_KEY=
PORT=3200
